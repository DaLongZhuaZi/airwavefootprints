# Dependencies
/node_modules/
/oh_modules/
**/node_modules/
**/oh_modules/

# HarmonyOS / DevEco generated files
/local.properties
**/build/

# ── 迁移期间的一次性脚本 ──
# 这些是改文件用的临时 PowerShell（fix-* / add-* / wire-* …），
# 不是产品代码，也不是可复用工具，留在本机即可。
# scripts/fieldwatch-data/ 下的数据源生成工具**要提交**，故不在此列。
scripts/*.ps1
scripts/*.txt

# 从编译缓存里清理出来的孤儿产物（对应源文件已删除）。
# 保留是为了可追溯，不属于源码，也不应提交。
.build-orphans/
**/.cxx/
**/.preview/
**/.test/
/.hvigor/
**/.hvigor/
/.appanalyzer/
**/.appanalyzer/
*.hap
*.app
*.hsp

# Native / analyzer local config
/.clangd
/.clang-format
/.clang-tidy
compile_commands.json

# Logs, diagnostics, and temporary files
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*~
bugreport*.txt
*_bugreport*.txt
hilog*.txt
faultlog/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / tooling cache
.npm/
.pnpm-store/
.yarn/
.parcel-cache/
.turbo/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
/.idea/
/.vscode/

# Agent local state
/.antigravitycli/
/.agent-state/
**/.agent-state/
**/.agent-rules/*.local.md
/.claude/
/.atomcode/
/.workbuddy/
/.deveco/
/.cursor/
/.windsurf/
/.codex/
/.trae/
/.kiro/
/.opencode/
/.continue/
/.aider*
/.gemini/
/.openhands/

# Local rule facts
/.local-rules/*.local.md
/.local-rules/snapshots/
/.local-rules/*.log
/.local-rules/*.tmp

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example

# Signing and certificate files
*.p12
*.cer
*.csr
*.crt
*.der
*.p7b
*.pem
*.pfx
*.key
*.keystore
*.jks

# 会话期间的临时截图与脚本
/.tmp-shots/


# ── 真机验收期间的取样与截图（仓库根目录）──
# 这些是本机验收流程留下的证据文件：截图、取样的导出样本、控件布局 dump、
# 桌面卡片 prefs 等。它们体积大、与源码无关、每次验收都会重新生成，
# 只作为本机留档，不进版本库。（.agent-state/ 下的检查点会引用它们，故不删除。）
/fw-*
/crop-*
/fps_*.csv
/widget-*.xml
/fieldwatch-launcher.*
/scripts/tmp_*
/tmp/
